{
  "name": "@drivej/candle-animation",
  "version": "1.0.3",
  "description": "Interactive birthday candle animation with PixiJS and React",
  "type": "module",
  "main": "./dist/candle-animation.umd.js",
  "module": "./dist/candle-animation.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/candle-animation.es.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/candle-animation.umd.js"
      }
    },
    "./assets/*": "./src/assets/*"
  },
  "files": [
    "dist",
    "src/assets",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:lib": "vite build --config vite.config.lib.ts && tsc --emitDeclarationOnly --declaration --declarationDir dist",
    "preview": "vite preview",
    "test": "cd test-app && npm run dev"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "gsap": "^3.12.5",
    "pixi.js": "^8.0.0",
    "usehooks-ts": "^3.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.2.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "typescript": "^5.9.3",
    "vite": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/drivej/candle-animation.git"
  },
  "keywords": [
    "react",
    "pixi.js",
    "animation",
    "candle",
    "birthday",
    "particles"
  ],
  "author": "Jason Contento",
  "license": "MIT"
}
