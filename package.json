{
  "name": "@jasoncontento/candle-animation",
  "version": "1.0.0",
  "description": "Interactive birthday candle animation with PixiJS and React",
  "type": "module",
  "main": "./dist/candle-animation.umd.js",
  "module": "./dist/candle-animation.es.js",
  "exports": {
    ".": {
      "import": "./dist/candle-animation.es.js",
      "require": "./dist/candle-animation.umd.js"
    },
    "./assets/*": "./assets/*"
  },
  "files": [
    "dist",
    "assets",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:lib": "vite build --config vite.config.lib.js",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "dependencies": {
    "pixi.js": "^8.0.0",
    "gsap": "^3.12.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "vite": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jasoncontento/candle-animation.git"
  },
  "keywords": [
    "react",
    "pixi.js",
    "animation",
    "candle",
    "birthday",
    "particles"
  ],
  "author": "Jason Contento",
  "license": "MIT"
}

